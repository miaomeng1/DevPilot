MYSQL_ROOT_PASSWORD=change-me-root
MYSQL_DATABASE=devpilot
MYSQL_USER=devpilot
MYSQL_PASSWORD=change-me-database
REDIS_PASSWORD=change-me-redis
JWT_SECRET=replace-with-at-least-32-random-bytes
DEV_PILOT_MASTER_KEY=replace-with-a-base64-encoded-32-byte-key
SERVER_PORT=8080
PUBLIC_PORT=8080
DEV_PILOT_PUBLIC_URL=http://localhost:8080
AUTH_COOKIE_SECURE=false

# Production registry overlay (replace with your registry namespace and immutable SHA tag).
DEVPILOT_IMAGE_PREFIX=ghcr.io/example/devpilot
DEVPILOT_IMAGE_TAG=sha-000000000000
