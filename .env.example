MYSQL_ROOT_PASSWORD=change-me-root
MYSQL_DATABASE=devpilot
MYSQL_USER=devpilot
MYSQL_PASSWORD=change-me-database
REDIS_PASSWORD=change-me-redis
JWT_SECRET=replace-with-at-least-32-random-bytes
DEV_PILOT_MASTER_KEY=replace-with-a-base64-encoded-32-byte-key
MAINTENANCE_REPORT_SECRET=replace-with-at-least-32-random-bytes
PROMETHEUS_SCRAPE_TOKEN=replace-with-at-least-32-random-bytes

# Optional OTLP/HTTP metrics export. Leave disabled unless an OpenTelemetry
# Collector or compatible backend is reachable from devpilot-server.
OTEL_METRICS_ENABLED=false
OTEL_EXPORTER_OTLP_METRICS_ENDPOINT=http://otel-collector:4318/v1/metrics
OTEL_SERVICE_NAME=devpilot-server
OTEL_METRIC_EXPORT_INTERVAL=60s

# Optional off-host backup. Works with AWS S3, MinIO, Cloudflare R2 and other
# AWS CLI-compatible stores. Prefer an instance role; otherwise set a narrowly
# scoped access key that can only write/read this prefix.
BACKUP_S3_URI=
BACKUP_S3_ENDPOINT_URL=
BACKUP_S3_REGION=
BACKUP_S3_ACCESS_KEY_ID=
BACKUP_S3_SECRET_ACCESS_KEY=
SERVER_PORT=8080
PUBLIC_PORT=8080
DEV_PILOT_PUBLIC_URL=http://localhost:8080
AUTH_COOKIE_SECURE=false

# Production registry overlay (replace with your registry namespace and immutable SHA tag).
DEVPILOT_IMAGE_PREFIX=ghcr.io/example/devpilot
DEVPILOT_IMAGE_TAG=sha-000000000000
